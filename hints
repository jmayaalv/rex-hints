#!/usr/bin/env node
// Rex hints: hint letters over the URLs, paths, hashes, UUIDs and IPs on a
// pane's screen; type a hint, then c copy, o open, e edit (in a split),
// t edit in a tab, m move (a click). Mode "jump" is ace-jump: a word's first
// character, then its hint. Runs in a floating Rex pane; see README.md.
// Usage: hints SESSION BLOCK ZOOMED(1|0) [items|jump] [local|remote|VIEWER] [EDITOR],
// remote (or the viewer's Rex server address) when the viewer's Rex app is on
// another machine; EDITOR for edit and tab (by default `ec` or vim). Tests: node --test hints.test.js
const path = require("node:path");
const os = require("node:os");
const fs = require("node:fs");
const { execFileSync } = require("node:child_process");

// Lower priority wins where matches overlap (as in herdr-app-pluck).
const PATTERNS = [
  ["url", 10, /(?:https?|file):\/\/[^\s()"'<>`]+/gu],
  ["path", 20, /[.\p{L}\p{M}\p{N}_\-~@]*(?:\/[.\p{L}\p{M}\p{N}_\-@]+)+\/?(?::\d+(?::\d+)?)?/gu],
  ["uuid", 30, /\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b/gu],
  ["hash", 40, /\b(?=[0-9a-f]*[0-9])(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\b/gu],
  ["ipv4", 50, /\b\d{1,3}(?:\.\d{1,3}){3}\b/gu],
];
const TRAILING = /[.,;:!?)\]}>'"`]+$/u;
const ALPHABET = "asdfghjklqwertyuiopzxcvbnm";
const WIDE = [[0x1100, 0x115f], [0x2e80, 0xa4cf], [0xac00, 0xd7a3], [0xf900, 0xfaff], [0xfe30, 0xfe4f],
  [0xff00, 0xff60], [0xffe0, 0xffe6], [0x20000, 0x3fffd]];

// shortcut: approximate width table; upgrade if hints drift on other glyphs.
function cellWidth(ch) {
  if (/\p{M}|‍|️/u.test(ch)) return 0;
  const cp = ch.codePointAt(0);
  if (/\p{Emoji_Presentation}/u.test(ch) || WIDE.some(([a, b]) => cp >= a && cp <= b)) return 2;
  return 1;
}

const cells = (s) => [...s].reduce((n, ch) => n + cellWidth(ch), 0);

// A path's run of characters at the start of a row, after its indent.
const RUN = /^( *)([.\p{L}\p{M}\p{N}_\-~@\/:]+)/u;

// The cells an item covers: its own, then the rows a broken path goes on in.
const pieces = (i) => i.wrap ?? [{ row: i.row, col: i.col, width: cells(i.text) }];

// `cols`, the pane's width: Claude Code breaks a long path at the pane's edge
// and goes on at the next row's start, indented, so a path reaching the edge
// takes that run (and the next while it reaches the edge too).
// shortcut: a path that ends exactly at the edge takes the next row's first word; rare.
function findItems(lines, cols) {
  const rows = lines.map((line) => {
    const found = [];
    for (const [kind, priority, re] of PATTERNS) {
      for (const m of line.matchAll(re)) {
        const text = m[0].replace(TRAILING, "");
        if (text && (kind !== "path" || text.includes("/"))) found.push({ kind, priority, start: m.index, end: m.index + text.length, text, raw: m[0] });
      }
    }
    found.sort((a, b) => a.priority - b.priority || a.start - b.start);
    const kept = [];
    for (const f of found) if (!kept.some((k) => f.start < k.end && k.start < f.end)) kept.push(f);
    return kept.map((k) => ({ col: cells(line.slice(0, k.start)), text: k.text, kind: k.kind, raw: k.raw }));
  });
  rows.forEach((kept, row) => kept.forEach((item) => {
    if (item.kind !== "path" || !cols) return;
    let raw = item.raw, piece = { row, col: item.col, width: cells(raw) };
    const wrap = [piece];
    for (let m; piece.col + piece.width === cols && (m = lines[piece.row + 1]?.match(RUN));) {
      const next = { row: piece.row + 1, col: m[1].length, width: cells(m[2]) };
      rows[next.row] = rows[next.row].filter((o) => o.col >= next.col + next.width || o.col + cells(o.text) <= next.col);
      wrap.push(piece = next);
      raw += m[2];
    }
    if (wrap.length === 1) return;
    item.text = raw.replace(TRAILING, "");
    piece.width -= cells(raw) - cells(item.text);
    item.wrap = wrap;
  }));
  return rows.flatMap((kept, row) => kept.map(({ raw, ...item }) => ({ row, ...item })))
    .sort((a, b) => a.row - b.row || a.col - b.col);
}

function assignHints(items) {
  const order = [...items].sort((a, b) => b.row - a.row || a.col - b.col).slice(0, ALPHABET.length ** 2);
  const two = order.length > ALPHABET.length;
  return order.map((item, i) => ({
    ...item,
    hint: two ? ALPHABET[Math.floor(i / ALPHABET.length)] + ALPHABET[i % ALPHABET.length] : ALPHABET[i],
  }));
}

const ACTIONS = [["c", "copy"], ["o", "open"], ["e", "edit"], ["t", "tab"], ["m", "move"]];
const FITS = { url: "com", path: "coetm", uuid: "cm", hash: "cm", ipv4: "cm", word: "m" };

// The files leaf (https://leaf.dipxsy.app) reads; it refuses anything else.
// URLs stay with the browser, though leaf reads web pages too.
// shortcut: leaf's pictures are "png, jpg, gif, webp, svg and more"; add a type here if one is missing.
const LEAF_READS = /\.(pdf|epub|md|markdown|png|jpe?g|gif|webp|svg|bmp|tiff?|heic|avif)$/i;
const isWeb = (item) => /^https?:\/\//.test(item.text ?? "");
const forLeaf = (item) => item.kind === "path" && LEAF_READS.test(item.text.replace(/(:\d+){1,2}$/, ""));

// `where.remote`: the picker runs on the pane's machine, not the viewer's, so
// macOS open would open there, out of sight. With leaf on this machine
// (`where.leaf`), the files it reads open in a pane beside, which the viewer
// sees. With the viewer's Rex address (`where.viewer`), web URLs open on the
// viewer's machine. Other paths don't (the file is here).
function actionsFor(item, where = {}) {
  const canOpen = !where.remote || (where.leaf && forLeaf(item)) || (where.viewer && isWeb(item));
  return ACTIONS.filter(([key]) => FITS[item.kind].includes(key) && (key !== "o" || canOpen))
    .map(([key, name]) => ({ key, name }));
}

function parseTarget(text, cwd, home) {
  const m = text.match(/:(\d+)(?::(\d+))?$/);
  let file = m ? text.slice(0, m.index) : text;
  if (file.startsWith("~/")) file = path.join(home, file.slice(2));
  const target = { file: path.resolve(cwd, file) };
  if (m) target.line = Number(m[1]);
  if (m && m[2]) target.col = Number(m[2]);
  return target;
}

// The visible screen: the text format drops blank rows at the bottom of the
// screen, so count them from the VT tail's closing CRLFs.
function visibleScreen(textTail, vtTail, rows, truncated) {
  let lines = textTail.split("\n");
  if (truncated) lines = lines.slice(1);
  const vt = vtTail.replace(/(?<!\r)\n$/, "").replace(/(\x1b\[[0-9;?]*[A-Za-z])+$/, "");
  const blank = vt.match(/(?:\r\n)*$/)[0].length / 2;
  return lines.concat(Array(blank).fill("")).slice(-rows);
}

// The rows the picker shows, a row fewer than its pane has (a floating layer's
// frame takes one): it shows the last `rows` lines, so drop blank rows at the
// bottom first and a short screen keeps its top row.
function fitRows(lines, rows) {
  let n = lines.length;
  while (n > rows && !lines[n - 1].trim()) n--;
  return lines.slice(0, n);
}

// Items the picker shows: within its last `rows` lines, with room in its `cols`
// cells for a two-letter hint. A floating picker is 2 columns narrower than its
// pane, so an item reaching the pane's edge shows clipped; it acts whole.
function visibleItems(items, lineCount, cols, rows) {
  const first = Math.max(0, lineCount - rows);
  return items.filter((i) => i.row >= first && i.col + 2 <= cols);
}

function decodeKeys(chunk) {
  const keys = [];
  for (let i = 0; i < chunk.length; i++) {
    const c = chunk[i];
    if (c === "\x1b" && chunk[i + 1] === "[") {
      i += 2;
      while (i < chunk.length && !/[@-~]/.test(chunk[i])) i++;
    } else if (c === "\x1b" && chunk[i + 1] === "O") i++;
    else if (c === "\x1b" || c === "\x03") keys.push("escape");
    else if (c === "\r") keys.push("enter");
    else if (c === "\x7f" || c === "\b") keys.push("backspace");
    else if (/[a-z]/i.test(c)) keys.push(c.toLowerCase());
    else if (/[0-9_]/.test(c)) keys.push(c); // a word's first character in jump mode
  }
  return keys;
}

const initialState = (items) => ({ items, typed: "", picked: null, done: null });

// Jump mode (ace-jump): words starting with a character, case-insensitive.
const WORD = /[\p{L}\p{M}\p{N}_]+/gu;
function findWords(lines, ch) {
  const items = [];
  lines.forEach((line, row) => {
    for (const m of line.matchAll(WORD)) {
      if (m[0][0].toLowerCase() === ch) items.push({ row, col: cells(line.slice(0, m.index)), text: m[0], kind: "word" });
    }
  });
  return items;
}

const prepareJump = (lines, cols, rows) => ({
  ...initialState([]), mode: "jump", query: null, notice: "",
  words: (ch) => assignHints(visibleItems(findWords(lines, ch), lines.length, cols, rows)),
});

function step(state, key) {
  if (key === "escape") return { ...state, done: { action: "cancel" } };
  if (state.mode === "jump" && state.query === null) {
    if (!/^[a-z0-9_]$/.test(key)) return state;
    const items = state.words(key);
    if (items.length === 1) return { ...state, done: { action: "move", item: items[0] } };
    if (!items.length) return { ...state, notice: ` No words start with “${key}”; type another, esc cancels` };
    return { ...state, query: key, items, notice: "" };
  }
  if (state.mode === "jump" && key === "backspace" && !state.typed) return { ...state, query: null, items: [] };
  if (!state.items.length) return { ...state, done: { action: "cancel" } };
  const pick = (typed) => {
    const picked = state.items.find((i) => i.hint === typed) ?? null;
    if (picked && state.mode === "jump") return { ...state, typed, picked, done: { action: "move", item: picked } };
    return { ...state, typed, picked };
  };
  if (key === "backspace") return pick(state.typed.slice(0, -1));
  if (state.picked) {
    const name = key === "enter" ? "copy" : actionsFor(state.picked, state.where).find((a) => a.key === key)?.name;
    return name ? { ...state, done: { action: name, item: state.picked } } : state;
  }
  if (!/^[a-z]$/.test(key)) return state;
  const typed = state.typed + key;
  return state.items.some((i) => i.hint.startsWith(typed)) ? pick(typed) : state;
}

const rgb = (hex, bg) => `\x1b[${bg ? 48 : 38};2;${parseInt(hex.slice(1, 3), 16)};${parseInt(hex.slice(3, 5), 16)};${parseInt(hex.slice(5, 7), 16)}m`;
const RESET = "\x1b[0m"; // each style starts from a reset, so a hint's background and bold never run on
const DIM = RESET + rgb("#6c7086"), MATCH = RESET + rgb("#cdd6f4"), HINT = RESET + "\x1b[1m" + rgb("#000000") + rgb("#ffd60a", true);
const PICKED = RESET + rgb("#ffd60a") + rgb("#3d3200", true); // the picked item: muted, the hint letters stay bright
const MENU = { copy: "copy c/⏎", open: "open o", edit: "edit e", tab: "tab t", move: "move m" };

// Screen row `row`: dim text, bright items, hint letters over an item's first cells.
function renderRow(line, row, items, state, cols) {
  let out = "", at = 0;
  for (const ch of line) {
    const w = cellWidth(ch);
    if (at + w > cols) break;
    const it = items.find((i) => pieces(i).some((p) => p.row === row && at >= p.col && at < p.col + p.width));
    let style = DIM, text = ch;
    if (it && state.picked === it) style = PICKED;
    else if (it && it.hint.startsWith(state.typed) && !state.picked) {
      const k = row === it.row ? at - it.col : Infinity;
      if (k < it.hint.length) [style, text] = [HINT, it.hint[k]];
      else style = MATCH;
    }
    out += style + text;
    at += w;
  }
  return out + RESET;
}

function render(state, lines, cols, rows) {
  const first = Math.max(0, lines.length - rows);
  const shown = lines.slice(first);
  while (shown.length < rows) shown.push("");
  const out = shown.map((line, r) => renderRow(line, first + r, state.items, state, cols));
  const note = (text) => HINT + text.slice(0, cols) + RESET;
  if (!state.items.length && state.mode !== "jump") out[0] = note(" No items here — any key closes");
  if (state.notice) out[rows - 1] = note(state.notice);
  if (state.picked) {
    const menu = actionsFor(state.picked, state.where).map((a) => MENU[a.name]).join(" · ");
    out[rows - 1] = note(` ${menu}   esc cancel`);
  }
  return "\x1b[?7l\x1b[H\x1b[2J" + out.join("\r\n");
}

const run = (cmd, args, input) => execFileSync(cmd, args, { input, encoding: "utf8", maxBuffer: Infinity });

// The last `bytes` of a pane's output, so huge scrollbacks are never read whole.
// `format` answers with `content` (whole, or only its head plus a blob `id`);
// `blob_read` answers with `data`.
function readTail(call, format, bytes, extra = {}) {
  const r = call("format", { format, max_bytes: bytes, ...extra });
  if (r.eof || r.id == null) return { text: r.content, truncated: false };
  let offset = Math.max(0, r.total - bytes), text = "";
  const truncated = offset > 0;
  // Ask for the server's largest reply so the tail comes back in one piece: a
  // tail that starts mid-character gets 3-byte U+FFFDs for 1-byte partials,
  // which would end a smaller reply early and make the next offset drift.
  // shortcut: tails over 983040 bytes still loop; only an enormous window gets there.
  for (;;) {
    const b = call("blob_read", { id: r.id, offset, max_bytes: 983040 });
    text += b.data ?? "";
    if (b.eof || !b.data) return { text, truncated };
    offset += Buffer.byteLength(b.data);
  }
}
// The picker's starting state: hints on the items a cols x rows picker shows;
// `width`, the source pane's, is where long paths break.
const prepare = (lines, cols, rows, width = cols) =>
  initialState(assignHints(visibleItems(findItems(lines, width), lines.length, cols, rows)));

const SHELL = "com.superlogical.terminal.shell";

// The cursor of a shell at its prompt: a primary screen whose program takes no
// clicks. `vt` is the screen's tail read with extra_cursor, `modes` its modes.
function promptOf(vt, modes, lines) {
  const m = vt.match(/\x1b\[(\d+);(\d+)H$/);
  const clicks = modes.modes.some((x) => x.name.startsWith("mouse_event") && x.set);
  if (!m || modes.screen !== "primary" || clicks) return undefined;
  return { row: m[1] - 1, col: m[2] - 1, line: lines[m[1] - 1] ?? "" };
}

// The arrow presses that take a line editor from cell `from` to cell `to` of
// `line`: one per character between them, blank cells past the text as spaces.
// shortcut: a combining mark counts as no press, as zsh's COMBINING_CHARS does; unset, zsh needs one more.
function arrowsTo(line, from, to) {
  const [lo, hi] = from < to ? [from, to] : [to, from];
  let cell = 0, n = 0;
  for (const ch of line) {
    const w = cellWidth(ch);
    if (w && cell >= lo && cell < hi) n++;
    cell += w;
  }
  n += Math.max(0, hi - Math.max(lo, cell));
  return Array(n).fill(from < to ? "right" : "left");
}

// The line argument `editor` (its command's name) reads: Emacs +LINE:COL, vim a
// cursor() call, anything else +LINE.
function editorAt(editor, t) {
  if (!t.line) return [];
  const name = path.basename(editor.split(" ")[0]);
  if (/^(vi|vim|nvim)$/.test(name)) return [`+call cursor(${t.line},${t.col || 1})`];
  return [/^(ec|emacs|emacsclient)$/.test(name) ? `+${t.line}${t.col ? `:${t.col}` : ""}` : `+${t.line}`];
}
// Edit and tab run `editor` (setup's), or else the shell's `ec` when it has one
// (only the pane's host knows), else vim, in an interactive zsh so functions and
// aliases work.
function editCommand(editor, t) {
  if (editor) return ["/bin/zsh", "-ic", `${editor} "$@"`, "edit", ...editorAt(editor, t), t.file];
  return ["/bin/zsh", "-ic", 'if whence ec >/dev/null; then ec ${2:+"$2"} "$1"; else vim ${3:+"$3"} "$1"; fi', "edit",
    t.file, editorAt("ec", t)[0] ?? "", editorAt("vim", t)[0] ?? ""];
}

// The chosen action. `exec` and `write` are swapped in tests.
function runAction(action, item, ctx, exec = run, write = (s) => process.stdout.write(s)) {
  const api = (method, body) =>
    exec("rex", ["api", "call", "-s", ctx.session, method, "-"], JSON.stringify({ session_id: ctx.session, ...body }));
  // OSC 52: the Rex app showing this pane copies, so a pane on another host
  // copies onto the Mac you're at. Rex applies it only while it's frontmost.
  if (action === "copy") return write(`\x1b]52;c;${Buffer.from(item.text).toString("base64")}\x07`);
  if (action === "move") {
    // A shell ignores clicks, so on its cursor's row arrow keys get there.
    // shortcut: a command wrapped onto more rows still gets a click (which does nothing); join its rows if that matters.
    if (ctx.prompt && ctx.prompt.row === item.row) {
      const keys = arrowsTo(ctx.prompt.line, ctx.prompt.col, item.col);
      if (keys.length) exec("rex", ["send-key", "-s", ctx.session, "-b", ctx.block, ...keys]);
      return;
    }
    for (const a of ["press", "release"]) {
      api("block.event", { block_id: ctx.block, event: { type: "mouse", payload: { action: a, button: "left", x: item.col, y: item.row } } });
    }
    return;
  }
  // leaf's own placing, as its Rex plugin does: typed at an idle prompt, in
  // place of a document leaf shows there, or else in a pane beside.
  if (action === "open" && ctx.leaf && forLeaf(item)) {
    const target = parseTarget(item.text, ctx.cwd, ctx.home).file;
    return exec(ctx.leaf, ["rex", "place", ctx.block, path.basename(target), "--", "open", target]);
  }
  // The viewer's init.lua defines open_url (see README.md).
  if (action === "open" && ctx.viewer && isWeb(item)) return exec("rex", ["-S", ctx.viewer, "do", "open_url", "--args", JSON.stringify({ url: item.text })]);
  if (action === "open") return exec("open", [item.kind === "url" ? item.text : parseTarget(item.text, ctx.cwd, ctx.home).file]);
  const t = parseTarget(item.text, ctx.cwd, ctx.home);
  const layout = { block: { flavor: SHELL, label: "edit", options: {
    cwd: ctx.cwd, shell: "none", command: editCommand(ctx.editor, t), path_prepend: ["/opt/homebrew/bin"],
  } } };
  if (action === "edit") return api("session.new_split", { anchor_id: ctx.block, direction: "horizontal", side: "after", focus: true, layout });
  if (action === "tab") return api("session.new_window", { focus: true, layout });
}

function main() {
  const [session, block, zoomed, mode, where, editor] = process.argv.slice(2);
  const remote = Boolean(where) && where !== "local";
  const viewer = remote && where !== "remote" ? where : undefined;
  const leaf = (process.env.PATH ?? "").split(path.delimiter).filter(Boolean).map((dir) => path.join(dir, "leaf"))
    .find((file) => { try { fs.accessSync(file, fs.constants.X_OK); return true; } catch { return false; } });
  const ctx = { session, block, cwd: process.cwd(), home: os.homedir(), viewer, leaf, editor: editor || undefined };
  const { stdin, stdout: out } = process;
  const call = (method, args) => JSON.parse(run("rex", ["block", "call", "-s", session, "-b", block, method, JSON.stringify(args ?? {})]));
  const tail = (format, bytes, extra) => readTail(call, format, bytes, extra);
  let state, lines, failing = false;
  // Read the source screen and hint what this picker shows; again on resize,
  // since Rex sizes the picker (and a zoomed source reflows) after it starts.
  const load = () => {
    const size = call("size");
    const text = tail("text", size.rows * (size.columns * 4 + 1));
    lines = fitRows(visibleScreen(text.text, tail("vt", 4 * size.rows + 64).text, size.rows, text.truncated), out.rows);
    state = { ...(mode === "jump" ? prepareJump : prepare)(lines, out.columns, out.rows, size.columns), where: { remote, viewer, leaf: Boolean(leaf) } };
  };
  const restore = () => {
    out.write("\x1b[?7h\x1b[?25h\x1b[?1049l");
    if (stdin.isTTY) stdin.setRawMode(false);
  };
  // Errors stay on screen until a key; exit 0 so Rex doesn't keep a dead pane.
  const fail = (e) => {
    if (failing) return;
    failing = true;
    stdin.removeAllListeners("data");
    out.write(`\x1b[?7h\x1b[H\x1b[2J hints: ${String(e?.message ?? e).trim()}\r\n any key closes`);
    stdin.once("data", () => { restore(); process.exit(0); });
  };
  const draw = () => out.write(render(state, lines, out.columns, out.rows));
  const finish = (done) => {
    stdin.removeAllListeners("data");
    if (done.action === "move") ctx.prompt = promptOf(tail("vt", 64, { extra_cursor: true }).text, call("modes"), lines);
    if (done.action !== "cancel") runAction(done.action, done.item, ctx);
    const newPane = ["edit", "tab"].includes(done.action) || (done.action === "open" && leaf && forLeaf(done.item));
    if (zoomed === "1" && !newPane) {
      run("rex", ["api", "call", "-s", session, "session.zoom_block", "-"], JSON.stringify({ session_id: session, block_id: block, zoom: true }));
    }
    restore();
    process.exit(0);
  };

  process.on("uncaughtException", fail);
  out.write("\x1b[?1049h\x1b[?25l");
  stdin.setRawMode(true);
  stdin.setEncoding("utf8");
  stdin.resume();
  try {
    load();
    draw();
  } catch (e) {
    return fail(e);
  }
  out.on("resize", () => { try { if (!failing) { load(); draw(); } } catch (e) { fail(e); } });
  stdin.on("data", (chunk) => {
    try {
      for (const key of decodeKeys(chunk)) {
        state = step(state, key);
        if (state.done) return finish(state.done);
      }
      draw();
    } catch (e) {
      fail(e);
    }
  });
}

module.exports = {
  findItems, cellWidth, assignHints, actionsFor, parseTarget,
  visibleScreen, fitRows, visibleItems, decodeKeys, initialState, step, render, runAction, readTail, prepare,
  findWords, prepareJump, promptOf, arrowsTo, editCommand,
};

// The program: run as a file, or as `node -e CODE hints ARGS` (how init.lua starts
// it on another host).
if (require.main === module || module.id === "[eval]") main();
